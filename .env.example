API_PORT=3001
# PostgreSQL 14 installed on this computer (port 5432).
# Replace USER and PASSWORD; URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/eduassess
# true loads demo classes, students and accounts (for trying the app). Leave false for real use.
SEED_DEMO_DATA=false
# Generate a random value of at least 32 characters; keep this file private.
AUTH_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Password of the first "admin" account (created when there are no users) and of the demo accounts.
SEED_ADMIN_PASSWORD=Admin@123456
SEED_TEACHER_PASSWORD=Teacher@123456
SEED_STUDENT_PASSWORD=Student@123456
# Gemini API keys are not configured here: an admin adds them on the "Khoá API AI" screen (stored encrypted in the database).
# Optional: Gemini models tried in order (comma-separated); the next is used if one is overloaded.
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview

# Optional: secret used to encrypt stored AI keys (defaults to AUTH_JWT_SECRET). Changing it makes stored keys unreadable.
# AI_KEYS_SECRET=

# How long a sign-in lasts (e.g. 7d, 12h, 30d). Default 7d.
# AUTH_TOKEN_TTL=7d
