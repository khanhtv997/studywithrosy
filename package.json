{
  "name": "eduassess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/main.ts",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "start": "tsx backend/main.ts",
    "db:create": "tsx backend/database/create-database.ts",
    "db:import-sqlite": "tsx backend/database/import-sqlite.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test backend/*.test.ts src/utils/*.test.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^11.2.9",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^7.18.5",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.27.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
