# Copy to .env.production on the server and fill in. Never commit the real file.

# PostgreSQL on the Ubuntu host. Inside the container the host is "host.docker.internal".
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://eduassess:CHANGE_ME_DB_PASSWORD@host.docker.internal:5432/eduassess

# Signs login tokens. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Encrypts the Gemini keys stored in the database. Keep it stable: changing it makes stored keys unreadable.
# Generate with: openssl rand -base64 48
AI_KEYS_SECRET=CHANGE_ME_ANOTHER_RANDOM_SECRET

# Password of the first "admin" account, created only when the users table is empty. Change it after signing in.
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# No demo classes/students on a real server.
SEED_DEMO_DATA=false

# Gemini models tried in order. API keys are added in the app: menu "Khoá API AI".
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview

# How long a sign-in lasts (e.g. 7d, 12h, 30d). Default 7d.
# AUTH_TOKEN_TTL=7d

# Google sign-in (optional). OAuth client ID of type "Web application" from Google Cloud Console;
# leave empty to hide the Google button. New Google users become teachers waiting for an admin's approval.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
